{#
  Override of stanford_basic's config-pages--stanford-local-footer.html.twig.

  The base template reads custom_lockup/lockup_option/use_default_logo/
  site_logo/line1-5 straight off the stanford_local_footer config_pages
  fields, ignoring anything set in hook_preprocess_config_pages__stanford_local_footer().
  GSE always shows the GSE logo-only lockup regardless of the site's local
  footer settings, so those specific values are hardcoded here from the
  variables gse_subtheme_preprocess_config_pages__stanford_local_footer()
  sets, while everything else still comes from the config page as normal.
#}
{% set cell2 %}
  <div class="flex-container">
    <div class="flex-md-6-of-12 su-margin-bottom-1">
      {{ content.su_local_foot_se_co }}
    </div>
    <div class="flex-md-6-of-12">
      {{ content.su_local_foot_tr2_co }}
    </div>
  </div>
{% endset %}

{% set action_links = [] %}
{% for link in config_pages.su_local_foot_action %}
  {% set action_links = action_links|merge([{url: link.getUrl().toString(), title: link.title}]) %}
{% endfor %}

{% set primary_links = [] %}
{% for link in config_pages.su_local_foot_primary %}
  {% set primary_links = primary_links|merge([{url: link.getUrl().toString(), title: link.title}]) %}
{% endfor %}

{% set secondary_links = [] %}
{% for link in config_pages.su_local_foot_second %}
  {% set secondary_links = secondary_links|merge([{url: link.getUrl().toString(), title: link.title}]) %}
{% endfor %}

{% set social_links = [] %}
{% for link in config_pages.su_local_foot_social %}
  {% set social_links = social_links|merge([{url: link.getUrl().toString(), title: link.title}]) %}
{% endfor %}


{{ include("jumpstart_ui:localfooter", {
  custom_lockup: custom_lockup,
  lockup_option: lockup_option,
  use_default_logo: use_default_logo,
  cell1: content.su_local_foot_pr_co,
  cell2: cell2,
  cell3: content.su_local_foot_tr_co,
  address: content.su_local_foot_address,
  action_links: action_links,
  social_links: social_links,
  primary_links_header: config_pages.su_local_foot_prime_h.value,
  primary_links: primary_links,
  secondary_links_header: config_pages.su_local_foot_second_h.value,
  secondary_links: secondary_links,
  signup_form_content: content.su_local_foot_f_intro,
  signup_form_action: config_pages.su_local_foot_f_url.value,
  signup_form_method: config_pages.su_local_foot_f_method.value,
  signup_form_field_submit_value: config_pages.su_local_foot_f_button.value,
  weblogin_url: weblogin_url,
  weblogin_text: config_pages.su_local_foot_sunet_t.value,
  lockup_title: lockup_title,
  site_logo: site_logo,
  site_logo_alt: lockup_title,
  line1: line1,
  line2: line2,
  line3: line3,
  line4: line4,
  line5: line5,
}, with_context = false) }}
